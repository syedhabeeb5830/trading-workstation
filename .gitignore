.venv/
__pycache__/
*.pyc

# Secrets & session caches — NEVER commit
.env
.zerodha_session.json
.kite_instruments.json

# Screener caches (regenerated on demand — universe + bulk OHLCV)
cache/

# Generated screen exports (regenerated each run)
reports/

# Local journal data (user-specific)
journal/alerts.log
journal/zerodha_snapshot.json
journal/scheduler.log
.scheduled_positions.bat
